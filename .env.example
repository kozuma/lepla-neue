# ローカル開発: docker compose up -d で起動する Postgres(compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lepla

# Payload 管理画面のセッション署名キー(任意のランダム文字列)
PAYLOAD_SECRET=change-me-to-a-random-string

# --- 以降は本番/後続フェーズで使用(ローカルでは未設定でよい) ---
# Supabase Auth(学習者側認証。導入フェーズで追加)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2 / Images(ローカルでは接続しない。画像は public/ 配下)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
